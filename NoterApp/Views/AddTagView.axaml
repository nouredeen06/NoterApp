<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="300"
        Width="260" Height="300"
        xmlns:vm="using:NoterApp.ViewModels"
        x:DataType="vm:AddTagViewModel"
        xmlns:models="using:NoterApp.Models"
        x:Class="NoterApp.Views.AddTagView"
        xmlns:conv="using:NoterApp.Converters"
        Title="AddTagView"
        x:Name="AddTag"
        Background="#121212">
    <Window.DataContext>
        <vm:AddTagViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:IsEqualConverter x:Key="IsEqualConverter" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.main">
            <Setter Property="Background" Value="#B80000" />
        </Style>
        <Style Selector="Button.main:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B80000" />
        </Style>
        <Style Selector="Button.main:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#B80000" />
        </Style>
        <Style Selector="Button.main:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#621818" />
        </Style>
        <Style Selector="Button.other">
            <Setter Property="Background" Value="#414141" />
        </Style>
        <Style Selector="Button.other:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#414141" />
        </Style>
        <Style Selector="Button.other:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#414141" />
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ff6666" />
        </Style>
        <Style Selector="Button.text:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ab1111" />
        </Style>
        <Style Selector="Button.text:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ab1111" />
        </Style>
        <Style Selector="ToggleButton.color">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.color:checked /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#B80000" />
            <Setter Property="Background" Value="{TemplateBinding Background}" />
        </Style>
        <Style Selector="ToggleButton.color:pointerover /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#ff6666" />
            <Setter Property="Background" Value="{TemplateBinding Background}" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,50">
        <StackPanel Grid.Row="0">
            <TextBox Margin="10" Height="35" Watermark="Enter Tag Name..." Text="{Binding TagName}" />
            <Grid Margin="10 5 10 5">
                <Border Height="2" Background="#424242" />
                <TextBlock Text=" Tag Color " Foreground="#a1a1a1" Background="#121212" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                </TextBlock>
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AllColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" MaxWidth="240" MaxHeight="300" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ColorInfo">
                                <ToggleButton Classes="color" Background="{Binding hex}" Width="24" Height="24"
                                              Margin="3"
                                              CornerRadius="5"
                                              Command="{Binding DataContext.SelectColorCommand, ElementName=AddTag}"
                                              CommandParameter="{Binding .}">
                                    <ToggleButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                            <Binding Path="." />
                                            <Binding Path="DataContext.SelectedColor" ElementName="AddTag" />
                                        </MultiBinding>
                                    </ToggleButton.IsChecked>
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding name}" />
                                    </ToolTip.Tip>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="text" FontSize="11" Padding="0" Margin="13 0">
                        <TextBlock TextDecorations="Underline" Text="Add Color..." />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ShowGridLines="True">
            <Button Grid.Column="1" Name="btnCancel" Classes="other" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Width="120"
                    Height="35" Content="Cancel" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="14" IsCancel="True" />
            <Button Grid.Column="0" Name="btnSave" Classes="main" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Width="120"
                    Height="35" Content="Save" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="14" Command="{Binding SaveTagCommand}" Click="BtnSave_OnClick" />
        </Grid>
    </Grid>


</Window>